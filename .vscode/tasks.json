{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure debug",
            "detail": "Configure the Debug build for Linux/Codespaces",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/codespaces",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake: build debug",
            "detail": "Configure and build all Debug targets for Linux/Codespaces",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/codespaces",
                "--parallel"
            ],
            "dependsOn": "cmake: configure debug",
            "problemMatcher": "$gcc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "close": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
