{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: build debug",
            "detail": "Configure + build the Debug target with MSVC",
            "type": "shell",
            "command": "${workspaceFolder}\\.vscode\\build-debug.cmd",
            "options": {
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "close": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
